@page "/"
@inject IJSRuntime JS

<PageTitle>Raised bed calculator</PageTitle>

<h1>Raised bed calculator</h1>

<p class="note">Stacked-board beds with butt joints. Prices are placeholders, not store prices.</p>

<section class="beds" aria-label="Your beds">
    <h2>Your beds</h2>
    <table id="beds">
        <thead>
            <tr><th>Bed</th><th>Size</th><th>How many</th><th></th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Beds.Count; i++)
            {
                var index = i;
                var order = Beds[index];
                @* The whole row opens the bed; the button is there for keyboard users. *@
                <tr id="bed-@index" class="@(index == Selected ? "selected" : null)" title="Click to review and edit this bed" @onclick="() => Selected = index">
                    <td>
                        <button type="button" id="edit-@index" aria-pressed="@(index == Selected ? "true" : "false")" @onclick="() => Selected = index">
                            Bed @(index + 1)
                        </button>
                    </td>
                    <td id="summary-@index">@Summary(order.Form)</td>
                    <td>
                        <input id="count-@index" type="number" min="1" step="1" aria-label="How many of bed @(index + 1)" @bind="order.Quantity" />
                    </td>
                    <td>
                        <button type="button" id="remove-@index" disabled="@(Beds.Count == 1)" @onclick="() => Remove(index)" @onclick:stopPropagation="true">Remove</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" id="add-bed" @onclick="AddBed">Add another bed</button>
    <small>Your beds are saved in this browser, so they are here when you come back.</small>
</section>

<section class="inputs" aria-label="Bed">
    <h2 id="editing">Bed @(Selected + 1)</h2>

    <div class="row">
        <label>
            Material
            <select id="treatment" @bind="Form.Treatment">
                <option value="@Treatment.PressureTreated">2x pressure treated</option>
                <option value="@Treatment.Untreated">2x untreated</option>
            </select>
        </label>

        <label>
            Board
            <select id="board" @bind="Form.BoardName">
                @foreach (var name in BoardProfile.TwoByWallBoards.Select(board => board.Name))
                {
                    <option value="@name">@name</option>
                }
            </select>
        </label>
    </div>

    <div class="row">
        <label>
            Length
            <span class="measure">
                <input id="length" type="number" min="0" step="any" @bind="Form.Length" />
                <select id="length-unit" aria-label="Length unit" @bind="Form.LengthUnit">
                    <option value="@LengthUnit.Feet">ft</option>
                    <option value="@LengthUnit.Inches">in</option>
                </select>
            </span>
        </label>

        <label>
            Width
            <span class="measure">
                <input id="width" type="number" min="0" step="any" @bind="Form.Width" />
                <select id="width-unit" aria-label="Width unit" @bind="Form.WidthUnit">
                    <option value="@LengthUnit.Feet">ft</option>
                    <option value="@LengthUnit.Inches">in</option>
                </select>
            </span>
        </label>
    </div>

    <div class="row">
        <label>
            Height
            <select id="courses" @bind="Form.Courses">
                @for (var courses = 1; courses <= MaxCourses; courses++)
                {
                    <option value="@courses">@HeightLabel(courses)</option>
                }
            </select>
        </label>

        <label>
            Corner bracing
            <select id="corner-bracing" @bind="Form.CornerBracing">
                <option value="@CornerBracing.None">None</option>
                <option value="@CornerBracing.TwoByTwoPosts">2x2 corner posts</option>
            </select>
        </label>
    </div>

    <div class="row">
        <label>
            Soil
            <select id="soil-mode" @bind="Form.SoilMode">
                <option value="@SoilMode.Prebagged">Bagged raised bed soil</option>
                <option value="@SoilMode.Mix">Mix: equal parts peat moss, compost, vermiculite</option>
            </select>
        </label>

        <label>
            Fill depth (in)
            <input id="fill-depth" type="number" min="0" step="any" @bind="Form.FillDepthInches" />
            <small>How deep the soil is. Starts 1 in below the top of the wall.</small>
        </label>
    </div>

    <div class="row">
        <label>
            Settling allowance (%)
            <input id="settling" type="number" min="0" step="any" @bind="Form.SettlingPercent" />
            <small>Extra soil to top up as the bed settles.</small>
        </label>
    </div>
</section>

<EstimateView Outcome="@BedEstimator.Estimate(Beds, MaterialCatalog.Placeholder)" />

@code {
    private const int MaxCourses = 8;

    private string? _saved;

    private List<BedOrder> Beds { get; set; } = [new BedOrder(new BedForm())];

    private int Selected { get; set; }

    private BedForm Form => Beds[Selected].Form;



    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _saved = await JS.InvokeAsync<string?>("localStorage.getItem", SavedBeds.StorageKey);
            if (SavedBeds.Deserialize(_saved) is { } beds)
            {
                Beds = beds;
                StateHasChanged();
            }

            return;
        }

        // Every change re-renders the page, so saving here keeps the stored list current.
        var json = SavedBeds.Serialize(Beds);
        if (!string.Equals(json, _saved, StringComparison.Ordinal))
        {
            _saved = json;
            await JS.InvokeVoidAsync("localStorage.setItem", SavedBeds.StorageKey, json);
        }
    }



    private void AddBed()
    {
        Beds.Add(new BedOrder(Form.Copy()));
        Selected = Beds.Count - 1;
    }



    private void Remove(int index)
    {
        Beds.RemoveAt(index);

        // Keep the same bed selected, or the one before it when the selected bed was removed from the end.
        if (Selected > index || Selected == Beds.Count)
        {
            Selected--;
        }
    }



    private static string Summary(BedForm form)
    {
        return $"{Display.Measure(form.Length, form.LengthUnit)} x {Display.Measure(form.Width, form.WidthUnit)}, "
            + $"{Display.Kind(new LumberKind(form.Board, form.Treatment))}, {Display.Inches(form.HeightInches)} high";
    }



    private string HeightLabel(int courses)
    {
        var boards = courses == 1 ? "1 board" : $"{courses} boards";
        return $"{Display.Inches(courses * Form.Board.WidthInches)} ({boards})";
    }
}
